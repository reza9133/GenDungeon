# ---------------------------------------------------------------- web app
# Address of a deployed GenDungeon v2 contract. Leave empty to run the app in
# demo mode (an in-memory simulation). A visitor can also pass ?contract=0x...
VITE_CONTRACT_ADDRESS=

# ---------------------------------------------------------------- end-to-end run
# studionet (default) or localnet
GENLAYER_NETWORK=studionet
# Override the RPC endpoint (optional)
GENLAYER_RPC=

# Four comma separated private keys: owner,alice,bob,carol.
# Leave empty and the run generates throwaway keys in .e2e/accounts.json.
E2E_KEYS=

# Plays tried before the run gives up on getting a victory (default 3)
E2E_MAX_ATTEMPTS=3
# Hard limit for the whole run, in minutes (default 90)
E2E_TIMEOUT_MIN=90
# Wait per transaction in milliseconds (default 600000)
E2E_TX_TIMEOUT_MS=600000
# Requests a minute the run may send to the RPC endpoint (the public one allows 30)
E2E_RPC_PER_MIN=24
# Set to 1 to also wait out the real quest time limit (adds about 5 minutes)
E2E_SLOW=0
# Use a contract you deployed yourself (owner key and constructor arguments must match docs/E2E.md)
E2E_CONTRACT=
